# Copy this file to .env and fill in your database details.
# .env is ignored by git, so your password never goes to GitHub.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=solution_builder
DB_USER=root
DB_PASS=

# Shown in the browser tab and page headers.
APP_NAME="Solution Summary Builder"
# Minutes of inactivity before a user is signed out.
SESSION_MINUTES=480
# Largest BOM template upload, in megabytes.
MAX_TEMPLATE_MB=10
# true shows PHP errors in the page; keep false except while troubleshooting.
APP_DEBUG=false

# Address used by ./start-mac.sh
APP_HOST=localhost
APP_PORT=8000
